# Copy to .env. Keep secrets out of browser and source control.
PORT=4318
HOST=127.0.0.1
DATABASE_PATH=./data/research.sqlite
# sqlite keeps local data even when Supabase credentials are present; auto selects Supabase when configured.
DATABASE_BACKEND=sqlite
# Set both to use Supabase instead of SQLite. Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Required when HOST is not loopback. Also used by n8n Header Auth.
STUDIO_API_TOKEN=
# Optional external portfolio webhook. Must be HTTPS; publishing requires UI approval.
PORTFOLIO_WEBHOOK_URL=
PORTFOLIO_WEBHOOK_TOKEN=
# Defaults to disabled. Prefer the provided n8n workflow for scheduling.
INGEST_INTERVAL_MINUTES=0
# Use an installed Unicode TTF on your server. Windows auto-detects Arial.
PDF_FONT_PATH=
