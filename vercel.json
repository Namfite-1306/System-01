{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "dist/fonts/space-grotesk-0.ttf"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/portfolio/:id", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "crons": [{ "path": "/api/cron", "schedule": "0 23 * * *" }],
  "env": {
    "SUPABASE_URL": "https://ozxiphcwcgpwukffehlt.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable__MPQuvBKKNz70snj7bF9Ow_ZBdRD9Ad",
    "DATABASE_BACKEND": "supabase",
    "INGEST_INTERVAL_MINUTES": "0"
  }
}
